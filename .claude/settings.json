{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git status --porcelain)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff --cached)",
      "Bash(git log)",
      "Bash(git log --oneline)",
      "Bash(shasum *)",
      "Bash(sha256sum *)",
      "Bash(md5 *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(bash scripts/validate-workspace)",
      "Bash(bash scripts/validate-spec *)",
      "Edit(//tmp/**)",
      "Bash(bash scripts/test-hooks)",
      "Bash(bash scripts/validate-ai-readiness *)",
      "Bash(jq *)",
      "Bash(bash scripts/measure-template-cost)",
      "Bash(bash scripts/validate-ai-readiness)",
      "Bash(git rev-parse *)",
      "Bash(git show --stat *)",
      "Bash(ls *)",
      "Bash(wc -l *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/secret-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/destructive-operation-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/secret-guard.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/prd-change-guard.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/provenance-guard.sh"
          }
        ]
      }
    ]
  },
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h"
}
