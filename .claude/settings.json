{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(*)",
      "Bash(bash scripts/test-hooks)",
      "Bash(bash scripts/test-hooks *)",
      "Bash(scripts/test-hooks)",
      "Bash(scripts/test-hooks *)",
      "Bash(bash scripts/validate-ai-readiness)",
      "Bash(bash scripts/validate-ai-readiness *)",
      "Bash(scripts/validate-ai-readiness)",
      "Bash(scripts/validate-ai-readiness *)",
      "Bash(bash scripts/validate-workspace)",
      "Bash(bash scripts/validate-workspace *)",
      "Bash(scripts/validate-workspace)",
      "Bash(scripts/validate-workspace *)",
      "Bash(bash scripts/validate-spec)",
      "Bash(bash scripts/validate-spec *)",
      "Bash(scripts/validate-spec)",
      "Bash(scripts/validate-spec *)",
      "Bash(bash scripts/verify-scope)",
      "Bash(bash scripts/verify-scope *)",
      "Bash(scripts/verify-scope)",
      "Bash(scripts/verify-scope *)",
      "Bash(bash scripts/measure-template-cost)",
      "Bash(bash scripts/measure-template-cost *)",
      "Bash(scripts/measure-template-cost)",
      "Bash(scripts/measure-template-cost *)",
      "Bash(python3 scripts/gen-test-hooks.py *)",
      "Bash(python3 scripts/drawio_to_mermaid.py *)",
      "Bash(python3 scripts/mermaid_to_drawio.py *)",
      "Edit",
      "Write",
      "NotebookEdit",
      "TodoWrite",
      "Task",
      "Edit(//tmp/**)",
      "mcp__claude_ai_Atlassian__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__mixpanel__Run-Query",
      "mcp__claude_ai_monday_com__get_board_items_page"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/secret-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/destructive-operation-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/secret-guard.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/prd-change-guard.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/provenance-guard.sh"
          }
        ]
      }
    ]
  },
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h"
}
